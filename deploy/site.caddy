# Blocos de site do Caddy deste projeto (happy4ever), lidos pelo edge (/srv/edge) via `site registrar`.
# Sem bloco global; seguranca e ip_real vêm do edge (o único snippet próprio é happy4ever_web).
# O script troca ${VAR} pelos valores do .env; os upstreams são os aliases da rede Docker "edge"
# (docker-compose.prod.yml).
#
#   https://${DOMAIN}       → happy4ever-web:3000  (site da plataforma: landing, preços, cadastro;
#                                                   também é o PLATFORM_HOST)
#   https://${API_DOMAIN}   → happy4ever-api:3333  (painel em /painel, login, webhooks, fotos)
#
# Os hosts do casamento (danigustavo, painel-danigustavo) são do projeto "casamento" e não entram
# aqui; quando o casamento migrar, ver docs/DEPLOY.md "Depois: trazer o casamento para a plataforma".

# Regras comuns dos hosts do site (Next.js).
(happy4ever_web) {
	encode zstd gzip
	import seguranca

	# Aviso de cache que só a API manda, pela rede interna (WEB_INTERNAL_URL).
	@interno path /api/revalidar
	respond @interno 404

	reverse_proxy happy4ever-web:3000 {
		import ip_real
		# Repassa cada pedaço na hora: as páginas com <Suspense> chegam em streaming.
		flush_interval -1
	}
}

${DOMAIN} {
	import happy4ever_web
}

${API_DOMAIN} {
	encode zstd gzip
	import seguranca

	# Planilha de convidados e fotos dos presentes (a API limita as fotos a 2 MB).
	request_body {
		max_size 10MB
	}

	# Só o que precisa ser público neste host. As rotas do site (/api/site, /api/invitations,
	# /api/orders...) o Next acessa pela rede interna e ficam fechadas aqui. Aceite de convite da
	# equipe e confirmação do cadastro vêm do painel; portaria e portal do fornecedor (Fase 7) são
	# páginas sem conta do mesmo build do painel, com API própria.
	@publico path /painel /painel/* /api/auth/* /api/admin/* /api/webhooks/* /api/health /uploads/* /api/team-invites/* /api/signup/* /portaria /portaria/* /api/checkin/* /fornecedor /fornecedor/* /api/vendor-portal/*
	handle @publico {
		reverse_proxy happy4ever-api:3333 {
			import ip_real
			# Header interno (Next → API); de fora nunca vale.
			header_up -X-Client-Ip
		}
	}

	@raiz path /
	handle @raiz {
		# O "*" é obrigatório: um argumento que começa com / seria lido como matcher de caminho.
		redir * /painel/ 302
	}

	handle {
		respond 404
	}
}
