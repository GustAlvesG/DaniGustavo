{
  "name": "@casamento/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "node --watch src/server.ts",
    "dev:painel": "vite build --watch --mode development",
    "start": "node src/server.ts",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p painel",
    "test": "vitest run"
  },
  "dependencies": {
    "@casamento/db": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "better-auth": "^1.7.25",
    "hono": "^4.13.18",
    "nodemailer": "^10.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
