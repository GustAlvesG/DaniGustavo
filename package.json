{
  "name": "casamento",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @casamento/db db:generate",
    "db:migrate": "pnpm --filter @casamento/db db:migrate",
    "db:seed": "pnpm --filter @casamento/db db:seed",
    "db:setup": "pnpm --filter @casamento/db db:setup",
    "db:reset": "pnpm --filter @casamento/db db:reset"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
