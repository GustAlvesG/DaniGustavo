# Copie para .env e preencha. Nunca commite o .env.

# --- Banco de dados ---
# Exemplo (XAMPP/MariaDB local): mysql://root:@127.0.0.1:3306/casamento
DATABASE_URL=

# --- API (Hono) ---
API_URL=
# Segredo compartilhado enviado pelo site no cabeçalho X-Web-Key
WEB_KEY=
# Pasta das fotos dos presentes enviadas pelo painel (vazio = apps/api/storage/uploads)
UPLOAD_DIR=

# --- Autenticação (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Só o seed usa estes e-mails e a senha (cria os usuários do painel); os avisos vão aos membros do evento.
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_PASSWORD_INICIAL=

# --- Cron / tarefas agendadas ---
CRON_SECRET=

# --- E-mail (SMTP). Em dev, Mailpit: host localhost, porta 1025 ---
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Pagamentos (passo a passo em docs/PERSONALIZAR.md §6) ---
# simulado (padrão: Pix e cartão de mentira, sem conta) ou asaas
PAYMENT_PROVIDER=simulado
# Chave de API do Asaas (Integrações → Chaves de API). Só a API usa; nunca vai ao navegador.
# Sandbox começa com $aact_hmlg_, produção com $aact_prod_. Pode colar com o $ mesmo.
ASAAS_API_KEY=
# sandbox ou producao. Vazio = deduzido pelo prefixo da chave (a API não sobe se divergir).
ASAAS_ENV=
# Token cadastrado no webhook do Asaas (32 a 255 caracteres, sem espaços; botão "Gerar token").
# Chega no header asaas-access-token. Obrigatório em produção.
ASAAS_WEBHOOK_TOKEN=

# --- Recebimentos da plataforma (Fase 5, docs/saas/fase-5.md) ---
# Chave mestra que cifra a chave de API das subcontas (64 caracteres hex: openssl rand -hex 32).
# Obrigatória em produção; vazia em desenvolvimento = derivada do BETTER_AUTH_SECRET.
# Trocar a chave torna ilegíveis as chaves já gravadas.
PAYMENT_SECRETS_KEY=
# Percentual da plataforma para organização SEM assinatura (0 a 50; vazio = 0,5). Desde a
# Fase 6 a taxa vem do plano de cada organização (plans.fee_bps).
PLATFORM_FEE_PERCENT=
# walletId da conta principal do Asaas (destino do split). Sem ele, com asaas, eventos que
# recebem em subconta com taxa ficam sem presentes em dinheiro (a API avisa no log).
ASAAS_PLATFORM_WALLET_ID=

# --- Plataforma: comercial e operação (Fase 6, docs/saas/fase-6.md) ---
# Assinatura das organizações: simulado (padrão) ou asaas (conta principal, mesma ASAAS_API_KEY).
BILLING_PROVIDER=simulado
# Host do site da plataforma (landing, preços e cadastro), como chega no Host. Ex. em dev:
# plataforma.localhost:3000. Vazio = sem landing.
PLATFORM_HOST=
# Domínio base dos endereços automáticos de evento (<slug>.<base>). Vazio = definir depois.
PLATFORM_BASE_DOMAIN=
# Cadastro self-service aberto (1) ou fechado (0, padrão).
SIGNUP_ENABLED=0
# E-mail que recebe os alertas da plataforma (rotinas falhando, erros 5xx). Vazio = só log.
PLATFORM_ALERT_EMAIL=
# Formato dos logs da API: json ou texto (vazio = json em produção, texto fora dela).
LOG_FORMAT=

# --- Site (Next.js) ---
NEXT_PUBLIC_SITE_URL=
# URL interna do site para a API avisar a revalidação de cache (vazio = usa SITE_URL)
WEB_INTERNAL_URL=
# URL do site: só reserva para os links da API quando o evento não tem domínio em event_domains
# (os links normais usam o host primário do evento). Vazio = usa NEXT_PUBLIC_SITE_URL.
SITE_URL=

# --- Plataforma multi-evento ---
# Os domínios dos eventos ficam em event_domains (CLI "domain:add" ou painel da organização);
# PLATFORM_BASE_DOMAIN e PLATFORM_HOST estão na seção da Fase 6 acima.

# --- Testes ---
# Banco dos testes da API (vazio = casamento_api_test no mesmo servidor do DATABASE_URL).
# Ele é apagado e recriado a cada execução: nunca aponte para o banco de desenvolvimento.
# TEST_DATABASE_URL=
