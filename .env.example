# Copie para .env e preencha. Nunca commite o .env.

# --- Banco de dados ---
# Exemplo (XAMPP/MariaDB local): mysql://root:@127.0.0.1:3306/casamento
DATABASE_URL=

# --- API (Hono) ---
API_URL=
# Segredo compartilhado enviado pelo site no cabeçalho X-Web-Key
WEB_KEY=
# Pasta das fotos dos presentes enviadas pelo painel (vazio = apps/api/storage/uploads)
UPLOAD_DIR=

# --- Autenticação (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_PASSWORD_INICIAL=

# --- Cron / tarefas agendadas ---
CRON_SECRET=

# --- E-mail (SMTP). Em dev, Mailpit: host localhost, porta 1025 ---
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Pagamentos (passo a passo em docs/PERSONALIZAR.md §6) ---
# simulado (padrão: Pix e cartão de mentira, sem conta) ou asaas
PAYMENT_PROVIDER=simulado
# Chave de API do Asaas (Integrações → Chaves de API). Só a API usa; nunca vai ao navegador.
# Sandbox começa com $aact_hmlg_, produção com $aact_prod_. Pode colar com o $ mesmo.
ASAAS_API_KEY=
# sandbox ou producao. Vazio = deduzido pelo prefixo da chave (a API não sobe se divergir).
ASAAS_ENV=
# Token cadastrado no webhook do Asaas (32 a 255 caracteres, sem espaços; botão "Gerar token").
# Chega no header asaas-access-token. Obrigatório em produção.
ASAAS_WEBHOOK_TOKEN=

# --- Telegram (notificações) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site (Next.js) ---
NEXT_PUBLIC_SITE_URL=
# URL do site usada nos links dos e-mails da API (vazio = usa NEXT_PUBLIC_SITE_URL)
SITE_URL=
