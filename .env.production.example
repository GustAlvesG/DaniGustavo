# Produção (VPS com Docker). Na VPS: cp .env.production.example .env  e preencha.
# Passo a passo em docs/DEPLOY.md. Nunca commite o .env.
#
# Segredos e senhas: gere com  openssl rand -hex 32  (hex não tem @ / : # que quebram URLs).

# Faz o `docker compose` usar o arquivo de produção sem precisar de -f.
COMPOSE_FILE=docker-compose.prod.yml

# Projeto "happy4ever" (branch saas), ao lado do projeto "casamento" (branch main) na mesma VPS.
# Os hosts do casamento (danigustavo, painel-danigustavo) continuam no projeto "casamento".

# --- Domínios (o DNS dos dois precisa apontar para a VPS antes de registrar o site no edge) ---
# O HTTPS e o e-mail do Let's Encrypt (ACME_EMAIL) ficam no edge, não aqui.
# Site da plataforma (landing, preços, cadastro). O compose usa o mesmo valor como PLATFORM_HOST.
DOMAIN=happy4ever.artzan.tech
# API e painel de todos os eventos e da plataforma (https://API_DOMAIN/painel). Login, uploads,
# portaria, portal do fornecedor e webhooks do Asaas ficam aqui.
API_DOMAIN=happy4ever-api.artzan.tech

# A partir de DOMAIN e API_DOMAIN o compose monta sozinho:
#   SITE_URL / NEXT_PUBLIC_SITE_URL = https://DOMAIN
#   BETTER_AUTH_URL                 = https://API_DOMAIN
#   PLATFORM_HOST                   = DOMAIN
#   API_URL = http://happy4ever-api:3333 (rede interna do Docker)

# Endereço do site visto pela API, para o aviso de revalidação do cache (POST /api/revalidar
# com { eventId, tags }). Rede interna do Docker; só mude se o serviço web mudar de nome.
WEB_INTERNAL_URL=http://happy4ever-web:3000

# --- Plataforma multi-evento (branch saas; docs/DEPLOY.md "Plataforma multi-evento") ---
# Cada evento responde pelos hosts cadastrados em event_domains (pela CLI, domain:add, ou pelo
# painel). Com SETUP_WEDDING=0 o setup não cria evento nem domínio. Domínio base para subdomínios de eventos
# (slug.<base>); ainda não usado pelo código.
# PLATFORM_BASE_DOMAIN=artzan.tech

# --- Banco (MySQL 8.4 no container "db") ---
MYSQL_DATABASE=happy4ever
MYSQL_USER=happy4ever
# openssl rand -hex 32
MYSQL_PASSWORD=
# openssl rand -hex 32 (só para manutenção; a aplicação usa MYSQL_USER)
MYSQL_ROOT_PASSWORD=
# O compose monta DATABASE_URL=mysql://MYSQL_USER:MYSQL_PASSWORD@db:3306/MYSQL_DATABASE
# (db = nome do serviço na rede interna). Não precisa definir aqui.

# --- Segredos da aplicação ---
# Chave entre o site e a API (header X-Web-Key). openssl rand -hex 32
WEB_KEY=
# Assinatura das sessões do painel. openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Painel: os dois usuários (criados pelo `run --rm setup`) ---
# ADMIN_EMAIL_2 vira admin da plataforma (platform_admin).
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
# Senha do primeiro login (mín. 10 caracteres). Troquem no painel (Conta) e apaguem daqui depois.
ADMIN_PASSWORD_INICIAL=

# --- Primeira carga (`run --rm setup`) ---
# 0 = só plataforma: planos, contas de ADMIN_EMAIL_* e o admin da plataforma, sem evento e sem
# importar o casamento (ele segue no projeto "casamento"; uma cópia aqui divergiria dos dados
# reais). 1 = carga do casamento (evento 1, conteúdo e domínio), só depois de trazer o banco dele
# (docs/DEPLOY.md "Depois: trazer o casamento para a plataforma").
SETUP_WEDDING=0

# --- E-mail (SMTP transacional: Brevo, Resend, Amazon SES, Zoho...) ---
# Vazio = os e-mails só aparecem no log da API (não chegam aos convidados).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Happy4ever <nao-responda@artzan.tech>

# --- Pagamentos (docs/PERSONALIZAR.md §6) ---
# simulado (Pix de mentira) ou asaas
PAYMENT_PROVIDER=simulado
# $aact_prod_... (produção) ou $aact_hmlg_... (sandbox). ENTRE ASPAS SIMPLES: no .env do
# Docker Compose, $nome vira variável e a chave chegaria vazia. Ex.: ASAAS_API_KEY='$aact_prod_...'
# (vale para qualquer valor com $).
ASAAS_API_KEY=
# Vazio = deduzido pelo prefixo da chave
ASAAS_ENV=
# Obrigatório com asaas em produção: 32 a 255 caracteres, sem espaços (openssl rand -hex 32).
# O mesmo valor vai no webhook do Asaas: https://API_DOMAIN/api/webhooks/payments
ASAAS_WEBHOOK_TOKEN=

# --- Recebimentos da plataforma (Fase 5, docs/saas/fase-5.md) ---
# Obrigatória: cifra a chave de API das subcontas do Asaas. openssl rand -hex 32
# NÃO troque depois de cadastrar subcontas (as chaves gravadas ficariam ilegíveis).
PAYMENT_SECRETS_KEY=
# Taxa para organização sem assinatura (0 a 50; vazio = 0,5). A taxa normal vem do plano.
PLATFORM_FEE_PERCENT=
# walletId da conta principal do Asaas (destino do split; sem ele, subcontas com taxa ficam
# sem presentes em dinheiro).
ASAAS_PLATFORM_WALLET_ID=
# Cada subconta recebe o próprio webhook em https://API_DOMAIN/api/webhooks/payments/accounts/<id>
# (cadastrado pela API ao criar a subconta; nada a configurar à mão).

# --- Plataforma: comercial e operação (Fase 6, docs/saas/fase-6.md) ---
# Assinatura das organizações: simulado (padrão) ou asaas (conta principal, mesma ASAAS_API_KEY).
BILLING_PROVIDER=simulado
# PLATFORM_HOST (site da plataforma) não se preenche: o compose usa o DOMAIN.
# Domínio base dos endereços automáticos de evento (<slug>.<base>). Vazio = definir depois.
# NÃO use happy4ever.artzan.tech: geraria slug.happy4ever.artzan.tech (dois níveis, fora do SSL
# universal da Cloudflare). Alternativas em docs/DEPLOY.md "Domínio da plataforma".
PLATFORM_BASE_DOMAIN=
# Cadastro self-service aberto (1) ou fechado (0, padrão).
SIGNUP_ENABLED=0
# E-mail que recebe os alertas da plataforma (rotinas falhando, erros 5xx). Vazio = só log.
PLATFORM_ALERT_EMAIL=
# Formato dos logs da API: json ou texto (vazio = json em produção, texto fora dela).
LOG_FORMAT=
